+    fn collect_flush_work(inner: &WalInner, target_lsn: Lsn) -> Vec<FlushSegmentWork> {
+        let mut by_seg: Vec<(u64, PathBuf, u64, bool, Vec<(Lsn, Vec<u8>)>)> = Vec::new();
+        for item in &inner.pending {
+            if item.lsn > target_lsn {
+                break;
+            }
+            if by_seg.last().map(|(id, ..)| *id) != Some(item.segment_id) {
+                let seg = inner
+                    .segments
+                    .iter()
+                    .find(|s| s.segment_id == item.segment_id);
+                let (path, flushed_bytes) = match seg {
+                    Some(s) => (s.path.clone(), s.flushed_bytes),
+                    None => continue,
+                };
+                let existed = path.exists();
+                by_seg.push((item.segment_id, path, flushed_bytes, existed, Vec::new()));
+            }
+            if let Some((_, _, _, _, recs)) = by_seg.last_mut() {
+                recs.push((item.lsn, item.bytes.clone()));
+            }
+        }
+        by_seg
+            .into_iter()
+            .map(|(segment_id, path, prev_flushed_bytes, existed_before, records)| {
