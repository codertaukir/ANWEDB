+                    .checked_add(bytes.len() as u64)
+                    .ok_or_else(|| Error::WalCorrupted("Segment byte count overflow".to_string()))?;
+            }
+            if let Err(e) = file.flush() {
+                let _ = file.set_len(seg.prev_flushed_bytes);
+                return Err(e.into());
